{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Minimal non-PII user account root document for Dulo cloud sync.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isAnonymous": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "isAnonymous", "createdAt", "updatedAt"]
    },
    "LikedSong": {
      "title": "LikedSong",
      "description": "A track liked by the authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "videoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "album": {
          "type": "string",
          "maxLength": 200
        },
        "duration": {
          "type": "number"
        },
        "artwork": {
          "type": "string",
          "maxLength": 1000
        },
        "source": {
          "type": "string",
          "enum": ["demo", "piped", "proxy", "local"]
        },
        "likedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "id", "videoId", "title", "artist", "duration", "source", "likedAt"]
    },
    "Playlist": {
      "title": "Playlist",
      "description": "User playlist synced across devices.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "artwork": {
          "type": "string",
          "maxLength": 1000
        },
        "sourceUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "tracks": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "id", "name", "tracks", "createdAt", "updatedAt"]
    },
    "HistoryEntry": {
      "title": "HistoryEntry",
      "description": "Recently played track record synced for the user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "videoId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "artist": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "album": {
          "type": "string",
          "maxLength": 200
        },
        "duration": {
          "type": "number"
        },
        "artwork": {
          "type": "string",
          "maxLength": 1000
        },
        "source": {
          "type": "string",
          "enum": ["demo", "piped", "proxy", "local"]
        },
        "playCount": {
          "type": "number"
        },
        "playedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "id", "videoId", "title", "artist", "duration", "source", "playCount", "playedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Root user sync marker document (non-PII)."
    },
    "/users/{uid}/liked_songs/{trackId}": {
      "schema": { "$ref": "#/entities/LikedSong" },
      "description": "User's liked songs synced across devices."
    },
    "/users/{uid}/playlists/{playlistId}": {
      "schema": { "$ref": "#/entities/Playlist" },
      "description": "User's custom and imported playlists."
    },
    "/users/{uid}/history/{historyId}": {
      "schema": { "$ref": "#/entities/HistoryEntry" },
      "description": "User's playback history."
    }
  }
}
